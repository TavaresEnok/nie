# Banco e servidor
# Usado no desenvolvimento local:
NIE_DATABASE_URL=postgres://nie:nie@127.0.0.1:5432/nie?sslmode=disable
# Usado pelo docker-compose.yml (senha do serviço postgres):
NIE_DB_PASSWORD=nie
NIE_ADDR=127.0.0.1:8080
NIE_DATA_DIR=./data

# Worker
NIE_WORKER=true
NIE_WORKERS=2
NIE_POLL_INTERVAL=2s
NIE_REQUEST_TIMEOUT=30s
NIE_RATE_LIMIT_PER_MINUTE=6

# Limites de extração
NIE_MAX_HTML_BYTES=5242880
NIE_MAX_PDF_BYTES=52428800
NIE_MAX_TEXT_BYTES=5242880

# Descoberta externa (opcional)
NIE_SEARXNG_URL=
NIE_GITHUB_ENABLED=false
NIE_GITHUB_TOKEN=

# Segurança (opcional; se definido, a UI pede o token)
NIE_API_TOKEN=

# Interface
NIE_WEB_DIR=
NIE_USER_AGENT=NIEBot/0.1 (+https://localhost)
NIE_LOG_LEVEL=info
