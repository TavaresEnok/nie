# Banco e servidor
# Usado no desenvolvimento local:
NIE_DATABASE_URL=postgres://nie:nie@127.0.0.1:5432/nie?sslmode=disable
# Usado pelo docker-compose.yml (senha do serviço postgres):
NIE_DB_PASSWORD=nie
NIE_ADDR=127.0.0.1:8080
NIE_DATA_DIR=./data

# Worker
NIE_WORKER=true
NIE_WORKERS=2
NIE_POLL_INTERVAL=2s
NIE_REQUEST_TIMEOUT=30s
NIE_RATE_LIMIT_PER_MINUTE=6

# Limites de extração
NIE_MAX_HTML_BYTES=5242880
NIE_MAX_PDF_BYTES=52428800
NIE_MAX_TEXT_BYTES=5242880

# Descobertas externas (V2 e V2.1)
NIE_SEARXNG_URL=http://localhost:8082
NIE_MWMBL_URL=https://mwmbl.org
NIE_WAYBACK_ENABLED=true
NIE_SOFTWARE_HERITAGE_ENABLED=true
NIE_MENTIONS_DISCOVERY_ENABLED=true
NIE_GITHUB_ENABLED=false
NIE_GITHUB_TOKEN=

# Executores Especializados (V2.1)
NIE_SCRAPY_URL=http://localhost:8085
NIE_CRAWL4AI_URL=http://localhost:8086

# Autonomia Contínua e Agendador (Fase 3)
NIE_SCHEDULER_ENABLED=true
NIE_SCHEDULER_INTERVAL=30s
NIE_AUTOMATIC_RESEARCH=true
NIE_MAX_RESEARCH_ROUNDS=3
NIE_OCR_ENABLED=false
NIE_OCR_MAX_PAGES=10
NIE_OCR_LANGUAGE=eng
NIE_OCR_TIMEOUT=45s
# Para OCR no Docker, selecione a imagem opcional:
# NIE_DOCKER_TARGET=runtime-ocr
NIE_GIT_LOCAL_DIR=
# Publicar o perfil Compose edge exige token. Com esta variável, o processo
# também recusa subir se NIE_API_TOKEN estiver vazio.
NIE_PUBLIC_EXPOSURE=false
# Busca por sentido. Exige NIE_PGVECTOR=true e um endpoint que devolva 768 dimensões.
# NIE_EMBED_URL=http://127.0.0.1:11434/api/embed
# NIE_EMBED_MODEL=nomic-embed-text

# Inteligência Artificial e Dossiês (Fase 2)
NIE_AI_PROVIDER=none
NIE_AI_BASE_URL=
NIE_AI_API_KEY=
NIE_AI_MODEL=qwen2.5:7b

# Segurança (se definido, a UI e a API exigem token)
NIE_API_TOKEN=

# Interface
NIE_WEB_DIR=
NIE_USER_AGENT=NIEBot/2.1 (+https://github.com/TavaresEnok/nie)
NIE_LOG_LEVEL=info
